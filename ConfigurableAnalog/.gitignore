# Connect IQ build output
bin/

# Local editor settings (contains the developer key path)
.vscode/settings.json

# Developer signing keys, never commit
*.der
*.pem

# Python tooling
__pycache__/
.ruff_cache/
.mypy_cache/

# Store packages and side-load binaries, rebuilt from source
release/*.iq
release/*.prg

# macOS Finder metadata
.DS_Store

# Compiler scratch output from side-load builds into release/
release/*-settings.json
release/*.debug.xml
release/external-mir/
release/internal-mir/
release/gen/
